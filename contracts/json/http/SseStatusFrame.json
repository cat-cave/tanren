{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "outcome": {
      "anyOf": [
        {
          "enum": [
            "ok",
            "hello_complete",
            "phase1_fixture_complete",
            "phase2_easy_complete",
            "phase2_medium_complete",
            "halted",
            "escape_hatch_hit",
            "retry_budget_exhausted",
            "window_exhausted",
            "cancelled",
            "failed"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "runId": {
      "type": "string"
    },
    "status": {
      "enum": [
        "queued",
        "running",
        "halted",
        "completed",
        "failed",
        "cancelled"
      ],
      "type": "string"
    }
  },
  "required": [
    "runId",
    "status",
    "outcome"
  ],
  "type": "object",
  "x-tanren-schema-id": "tanren.http.SseStatusFrame"
}
