{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "eventCursor": {
      "pattern": "^(0|[1-9][0-9]*)$",
      "type": "string"
    },
    "events": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "eventType": {
            "minLength": 1,
            "type": "string"
          },
          "id": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "string"
              }
            ]
          },
          "payload": {},
          "projectId": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "redactedPaths": {
            "default": [],
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "runId": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "specId": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "taskId": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "ts": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "id",
          "ts",
          "runId",
          "taskId",
          "specId",
          "projectId",
          "eventType",
          "payload",
          "redactedPaths"
        ],
        "type": "object"
      },
      "maxItems": 200,
      "minItems": 1,
      "type": "array"
    },
    "projectId": {
      "minLength": 1,
      "type": "string"
    },
    "runId": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "runId",
    "projectId",
    "events",
    "eventCursor"
  ],
  "type": "object",
  "x-tanren-schema-id": "tanren.http.SseEventsFrame"
}
