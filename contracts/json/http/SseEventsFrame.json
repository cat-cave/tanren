{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "events": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "eventType": {
            "minLength": 1,
            "type": "string"
          },
          "id": {
            "anyOf": [
              {
                "maximum": 9007199254740991,
                "minimum": 0,
                "type": "integer"
              },
              {
                "pattern": "^\\d+$",
                "type": "string"
              }
            ]
          },
          "payload": {},
          "projectId": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "redactedPaths": {
            "default": [],
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "runId": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "specId": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "taskId": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "ts": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "id",
          "ts",
          "runId",
          "taskId",
          "specId",
          "projectId",
          "eventType",
          "payload",
          "redactedPaths"
        ],
        "type": "object"
      },
      "type": "array"
    }
  },
  "required": [
    "events"
  ],
  "type": "object",
  "x-tanren-schema-id": "tanren.http.SseEventsFrame"
}
