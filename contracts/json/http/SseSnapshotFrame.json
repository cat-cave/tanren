{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "costCursor": {
      "pattern": "^(?:0|[1-9]\\d*)$",
      "type": "string"
    },
    "costs": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "billingMode": {
            "enum": [
              "per_token",
              "subscription",
              "self_hosted",
              "unattributed"
            ],
            "type": "string"
          },
          "cacheCreationTokens": {
            "maximum": 9007199254740991,
            "minimum": -9007199254740991,
            "type": "integer"
          },
          "cachedInputTokens": {
            "maximum": 9007199254740991,
            "minimum": -9007199254740991,
            "type": "integer"
          },
          "cli": {
            "minLength": 1,
            "type": "string"
          },
          "costBasis": {
            "enum": [
              "ccusage",
              "provider_response",
              "credits",
              "unknown",
              "unattributed"
            ],
            "type": "string"
          },
          "costUsd": {
            "anyOf": [
              {
                "pattern": "^\\d+(?:\\.\\d{1,6})?$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "id": {
            "pattern": "^[1-9]\\d*$",
            "type": "string"
          },
          "inputTokens": {
            "maximum": 9007199254740991,
            "minimum": -9007199254740991,
            "type": "integer"
          },
          "model": {
            "minLength": 1,
            "type": "string"
          },
          "outputTokens": {
            "maximum": 9007199254740991,
            "minimum": -9007199254740991,
            "type": "integer"
          },
          "projectId": {
            "minLength": 1,
            "type": "string"
          },
          "provider": {
            "minLength": 1,
            "type": "string"
          },
          "reasoningOutputTokens": {
            "maximum": 9007199254740991,
            "minimum": -9007199254740991,
            "type": "integer"
          },
          "recordedAt": {
            "format": "date-time",
            "type": "string"
          },
          "runId": {
            "minLength": 1,
            "type": "string"
          },
          "taskId": {
            "minLength": 1,
            "type": "string"
          },
          "totalTokens": {
            "maximum": 9007199254740991,
            "minimum": -9007199254740991,
            "type": "integer"
          }
        },
        "required": [
          "id",
          "runId",
          "taskId",
          "projectId",
          "cli",
          "provider",
          "model",
          "inputTokens",
          "cachedInputTokens",
          "cacheCreationTokens",
          "outputTokens",
          "reasoningOutputTokens",
          "totalTokens",
          "costUsd",
          "billingMode",
          "costBasis",
          "recordedAt"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "eventCursor": {
      "pattern": "^(?:0|[1-9]\\d*)$",
      "type": "string"
    },
    "projectId": {
      "minLength": 1,
      "type": "string"
    },
    "recentEvents": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "eventType": {
            "minLength": 1,
            "type": "string"
          },
          "id": {
            "pattern": "^[1-9]\\d*$",
            "type": "string"
          },
          "payload": {},
          "projectId": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "redactedPaths": {
            "default": [],
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "runId": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "specId": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "taskId": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "ts": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "id",
          "ts",
          "runId",
          "taskId",
          "specId",
          "projectId",
          "eventType",
          "payload",
          "redactedPaths"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "run": {
      "additionalProperties": false,
      "properties": {
        "branch": {
          "minLength": 1,
          "type": "string"
        },
        "endedAt": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "outcome": {
          "anyOf": [
            {
              "enum": [
                "ok",
                "halted",
                "escape_hatch_hit",
                "retry_budget_exhausted",
                "convergence_stalled",
                "window_exhausted",
                "window_paused",
                "awaiting_review",
                "cancelled",
                "failed"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "prUrl": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "projectId": {
          "minLength": 1,
          "type": "string"
        },
        "runId": {
          "minLength": 1,
          "type": "string"
        },
        "specId": {
          "minLength": 1,
          "type": "string"
        },
        "startedAt": {
          "format": "date-time",
          "type": "string"
        },
        "status": {
          "enum": [
            "queued",
            "running",
            "paused",
            "halted",
            "completed",
            "failed",
            "cancelled"
          ],
          "type": "string"
        },
        "trigger": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "runId",
        "specId",
        "projectId",
        "branch",
        "trigger",
        "status",
        "outcome",
        "startedAt",
        "endedAt",
        "prUrl"
      ],
      "type": "object"
    },
    "runId": {
      "minLength": 1,
      "type": "string"
    },
    "taskWatermark": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "tasks": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "attempt": {
            "maximum": 9007199254740991,
            "minimum": 0,
            "type": "integer"
          },
          "cli": {
            "minLength": 1,
            "type": "string"
          },
          "endedAt": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "failureKind": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "kind": {
            "enum": [
              "plan",
              "write",
              "check",
              "audit",
              "ci",
              "review",
              "merge",
              "demo",
              "forge",
              "triage",
              "convergence",
              "designOracle"
            ],
            "type": "string"
          },
          "model": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "outcome": {
            "anyOf": [
              {
                "enum": [
                  "passed",
                  "ok",
                  "pending",
                  "failed",
                  "rejected_by_checker",
                  "rejected_by_auditor",
                  "timed_out",
                  "crashed",
                  "window_exhausted",
                  "cancelled"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "parentTaskId": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "runId": {
            "minLength": 1,
            "type": "string"
          },
          "startedAt": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "status": {
            "enum": [
              "queued",
              "claimed",
              "running",
              "done",
              "failed",
              "cancelled"
            ],
            "type": "string"
          },
          "taskId": {
            "minLength": 1,
            "type": "string"
          },
          "title": {
            "type": "string"
          }
        },
        "required": [
          "taskId",
          "runId",
          "kind",
          "parentTaskId",
          "title",
          "status",
          "outcome",
          "failureKind",
          "attempt",
          "cli",
          "model",
          "startedAt",
          "endedAt"
        ],
        "type": "object"
      },
      "type": "array"
    }
  },
  "required": [
    "runId",
    "projectId",
    "run",
    "tasks",
    "recentEvents",
    "costs",
    "eventCursor",
    "costCursor",
    "taskWatermark"
  ],
  "type": "object",
  "x-tanren-schema-id": "tanren.http.SseSnapshotFrame"
}
