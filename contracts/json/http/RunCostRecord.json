{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "billingMode": {
      "enum": [
        "per_token",
        "subscription",
        "self_hosted",
        "unattributed"
      ],
      "type": "string"
    },
    "cacheCreationTokens": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "cachedInputTokens": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "cli": {
      "minLength": 1,
      "type": "string"
    },
    "costBasis": {
      "enum": [
        "ccusage",
        "provider_response",
        "credits",
        "unknown",
        "unattributed"
      ],
      "type": "string"
    },
    "costUsd": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "id": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "string"
        }
      ]
    },
    "inputTokens": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "model": {
      "minLength": 1,
      "type": "string"
    },
    "outputTokens": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "projectId": {
      "minLength": 1,
      "type": "string"
    },
    "provider": {
      "minLength": 1,
      "type": "string"
    },
    "reasoningOutputTokens": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "recordedAt": {
      "format": "date-time",
      "type": "string"
    },
    "runId": {
      "minLength": 1,
      "type": "string"
    },
    "taskId": {
      "minLength": 1,
      "type": "string"
    },
    "totalTokens": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "id",
    "runId",
    "taskId",
    "projectId",
    "cli",
    "provider",
    "model",
    "inputTokens",
    "cachedInputTokens",
    "cacheCreationTokens",
    "outputTokens",
    "reasoningOutputTokens",
    "totalTokens",
    "costUsd",
    "billingMode",
    "costBasis",
    "recordedAt"
  ],
  "type": "object",
  "x-tanren-schema-id": "tanren.http.RunCostRecord"
}
