{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "costCursor": {
      "pattern": "^(?:0|[1-9]\\d*)$",
      "type": "string"
    },
    "costs": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "billingMode": {
            "enum": [
              "per_token",
              "subscription",
              "self_hosted",
              "unattributed"
            ],
            "type": "string"
          },
          "cacheCreationTokens": {
            "maximum": 9007199254740991,
            "minimum": -9007199254740991,
            "type": "integer"
          },
          "cachedInputTokens": {
            "maximum": 9007199254740991,
            "minimum": -9007199254740991,
            "type": "integer"
          },
          "cli": {
            "minLength": 1,
            "type": "string"
          },
          "costBasis": {
            "enum": [
              "ccusage",
              "provider_response",
              "credits",
              "unknown",
              "unattributed"
            ],
            "type": "string"
          },
          "costUsd": {
            "anyOf": [
              {
                "pattern": "^\\d+(?:\\.\\d{1,6})?$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "id": {
            "pattern": "^[1-9]\\d*$",
            "type": "string"
          },
          "inputTokens": {
            "maximum": 9007199254740991,
            "minimum": -9007199254740991,
            "type": "integer"
          },
          "model": {
            "minLength": 1,
            "type": "string"
          },
          "outputTokens": {
            "maximum": 9007199254740991,
            "minimum": -9007199254740991,
            "type": "integer"
          },
          "projectId": {
            "minLength": 1,
            "type": "string"
          },
          "provider": {
            "minLength": 1,
            "type": "string"
          },
          "reasoningOutputTokens": {
            "maximum": 9007199254740991,
            "minimum": -9007199254740991,
            "type": "integer"
          },
          "recordedAt": {
            "format": "date-time",
            "type": "string"
          },
          "runId": {
            "minLength": 1,
            "type": "string"
          },
          "taskId": {
            "minLength": 1,
            "type": "string"
          },
          "totalTokens": {
            "maximum": 9007199254740991,
            "minimum": -9007199254740991,
            "type": "integer"
          }
        },
        "required": [
          "id",
          "runId",
          "taskId",
          "projectId",
          "cli",
          "provider",
          "model",
          "inputTokens",
          "cachedInputTokens",
          "cacheCreationTokens",
          "outputTokens",
          "reasoningOutputTokens",
          "totalTokens",
          "costUsd",
          "billingMode",
          "costBasis",
          "recordedAt"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "projectId": {
      "minLength": 1,
      "type": "string"
    },
    "runId": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "runId",
    "projectId",
    "costs",
    "costCursor"
  ],
  "type": "object",
  "x-tanren-schema-id": "tanren.http.SseCostsFrame"
}
