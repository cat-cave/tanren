{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "branch": {
      "minLength": 1,
      "type": "string"
    },
    "endedAt": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "outcome": {
      "anyOf": [
        {
          "enum": [
            "ok",
            "hello_complete",
            "phase1_fixture_complete",
            "phase2_easy_complete",
            "phase2_medium_complete",
            "halted",
            "escape_hatch_hit",
            "retry_budget_exhausted",
            "window_exhausted",
            "cancelled",
            "failed"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "prUrl": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "projectId": {
      "minLength": 1,
      "type": "string"
    },
    "runId": {
      "minLength": 1,
      "type": "string"
    },
    "specId": {
      "minLength": 1,
      "type": "string"
    },
    "startedAt": {
      "format": "date-time",
      "type": "string"
    },
    "status": {
      "enum": [
        "queued",
        "running",
        "halted",
        "completed",
        "failed",
        "cancelled"
      ],
      "type": "string"
    },
    "trigger": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "runId",
    "specId",
    "projectId",
    "branch",
    "trigger",
    "status",
    "outcome",
    "startedAt",
    "endedAt",
    "prUrl"
  ],
  "type": "object",
  "x-tanren-schema-id": "tanren.http.RunSummary"
}
