{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "attempt": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "cli": {
      "minLength": 1,
      "type": "string"
    },
    "endedAt": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "failureKind": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "kind": {
      "enum": [
        "plan",
        "write",
        "check",
        "audit",
        "ci",
        "review",
        "merge",
        "demo",
        "forge",
        "triage",
        "convergence"
      ],
      "type": "string"
    },
    "model": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "outcome": {
      "anyOf": [
        {
          "enum": [
            "passed",
            "ok",
            "pending",
            "failed",
            "rejected_by_checker",
            "rejected_by_auditor",
            "timed_out",
            "crashed",
            "window_exhausted",
            "cancelled"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "parentTaskId": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "runId": {
      "minLength": 1,
      "type": "string"
    },
    "startedAt": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "status": {
      "enum": [
        "queued",
        "claimed",
        "running",
        "done",
        "failed",
        "cancelled"
      ],
      "type": "string"
    },
    "taskId": {
      "minLength": 1,
      "type": "string"
    },
    "title": {
      "type": "string"
    }
  },
  "required": [
    "taskId",
    "runId",
    "kind",
    "parentTaskId",
    "title",
    "status",
    "outcome",
    "failureKind",
    "attempt",
    "cli",
    "model",
    "startedAt",
    "endedAt"
  ],
  "type": "object",
  "x-tanren-schema-id": "tanren.http.TaskTimelineEntry"
}
