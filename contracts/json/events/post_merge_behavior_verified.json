{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifactDigest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "behaviorRevisionId": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    },
    "deploySha": {
      "pattern": "^[0-9a-fA-F]{40}$",
      "type": "string"
    },
    "verdictId": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "behaviorRevisionId",
    "verdictId",
    "deploySha",
    "artifactDigest"
  ],
  "type": "object",
  "x-tanren-schema-id": "tanren.event.post_merge.behavior.verified"
}
