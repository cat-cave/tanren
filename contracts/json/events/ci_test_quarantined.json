{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "checkName": {
      "minLength": 1,
      "type": "string"
    },
    "file": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "intraRunFlakyCount": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "observationCount": {
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "type": "integer"
    },
    "passedOnRetryCount": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "quarantineId": {
      "minLength": 1,
      "type": "string"
    },
    "sampleShas": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "suite": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "testId": {
      "minLength": 1,
      "type": "string"
    },
    "toggledShaCount": {
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "type": "integer"
    }
  },
  "required": [
    "checkName",
    "toggledShaCount",
    "observationCount",
    "sampleShas",
    "quarantineId"
  ],
  "type": "object",
  "x-tanren-schema-id": "tanren.event.ci.test.quarantined"
}
