{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "additionalProperties": false,
      "properties": {
        "forgeReviewId": {
          "minLength": 1,
          "type": "string"
        },
        "forgeReviewState": {
          "const": "approved",
          "type": "string"
        },
        "forgeReviewUrl": {
          "minLength": 1,
          "type": "string"
        },
        "headSha": {
          "pattern": "^[0-9a-fA-F]{40}$",
          "type": "string"
        },
        "prNumber": {
          "maximum": 9007199254740991,
          "minimum": -9007199254740991,
          "type": "integer"
        },
        "prUrl": {
          "type": "string"
        },
        "reviewer": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "prUrl",
        "prNumber",
        "reviewer",
        "forgeReviewId",
        "forgeReviewState",
        "forgeReviewUrl",
        "headSha"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "prNumber": {
          "maximum": 9007199254740991,
          "minimum": -9007199254740991,
          "type": "integer"
        },
        "prUrl": {
          "type": "string"
        },
        "reviewer": {
          "type": "string"
        }
      },
      "required": [
        "prUrl",
        "prNumber"
      ],
      "type": "object"
    }
  ],
  "x-tanren-schema-id": "tanren.event.review.approved"
}
