{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "projectId": {
      "type": "string"
    },
    "repo": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "owner": {
          "type": "string"
        }
      },
      "required": [
        "owner",
        "name"
      ],
      "type": "object"
    },
    "secretNames": {
      "items": {
        "type": "string"
      },
      "type": "array"
    }
  },
  "required": [
    "projectId",
    "repo",
    "secretNames"
  ],
  "type": "object",
  "x-tanren-schema-id": "tanren.event.app_env.ci_propagated"
}
