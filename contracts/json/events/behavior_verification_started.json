{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifactDigest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "behaviorRevisionId": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    },
    "integrationNodeId": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "behaviorRevisionId",
    "integrationNodeId",
    "artifactDigest"
  ],
  "type": "object",
  "x-tanren-schema-id": "tanren.event.behavior.verification.started"
}
