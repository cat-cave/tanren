{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "command": {
      "type": "string"
    },
    "result": {
      "additionalProperties": false,
      "properties": {
        "exitCode": {
          "anyOf": [
            {
              "maximum": 9007199254740991,
              "minimum": -9007199254740991,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "failure": {
          "anyOf": [
            {
              "anyOf": [
                {
                  "additionalProperties": false,
                  "properties": {
                    "message": {
                      "type": "string"
                    },
                    "reason": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "reason"
                  ],
                  "type": "object"
                },
                {
                  "additionalProperties": false,
                  "properties": {
                    "reason": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "reason"
                  ],
                  "type": "object"
                }
              ]
            },
            {
              "additionalProperties": {},
              "propertyNames": {
                "type": "string"
              },
              "type": "object"
            }
          ]
        },
        "signal": {
          "type": "string"
        },
        "stderr": {
          "type": "string"
        },
        "stdout": {
          "type": "string"
        },
        "timedOut": {
          "type": "boolean"
        }
      },
      "required": [
        "exitCode",
        "stdout",
        "stderr",
        "timedOut"
      ],
      "type": "object"
    },
    "runnerId": {
      "type": "string"
    }
  },
  "required": [
    "runnerId",
    "command",
    "result"
  ],
  "type": "object",
  "x-tanren-schema-id": "tanren.event.runner.failed"
}
