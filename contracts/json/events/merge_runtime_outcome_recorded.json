{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "baseSha": {
      "minLength": 1,
      "type": "string"
    },
    "decision": {
      "enum": [
        "authorized",
        "blocked",
        "needs_attention"
      ],
      "type": "string"
    },
    "gateProofBundleId": {
      "minLength": 1,
      "type": "string"
    },
    "headSha": {
      "minLength": 1,
      "type": "string"
    },
    "mainSha": {
      "minLength": 1,
      "type": "string"
    },
    "memberSetHash": {
      "minLength": 1,
      "type": "string"
    },
    "outcomeId": {
      "minLength": 1,
      "type": "string"
    },
    "proofBundleDigest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "proofRoot": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "quarantineVersion": {
      "minLength": 1,
      "type": "string"
    },
    "result": {
      "enum": [
        "landed",
        "declined",
        "quarantined"
      ],
      "type": "string"
    }
  },
  "required": [
    "outcomeId",
    "decision",
    "result",
    "gateProofBundleId",
    "proofBundleDigest",
    "proofRoot",
    "quarantineVersion",
    "baseSha",
    "headSha",
    "memberSetHash"
  ],
  "type": "object",
  "x-tanren-schema-id": "tanren.event.merge.runtime_outcome.recorded"
}
