{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "externalLogins": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "integration": {
      "enum": [
        "mergify_queue",
        "native_queue",
        "direct_merge",
        "external_reviewer"
      ],
      "type": "string"
    },
    "mode": {
      "enum": [
        "operator_approval",
        "audit_only"
      ],
      "type": "string"
    },
    "posture": {
      "enum": [
        "strict",
        "open",
        "audit_only"
      ],
      "type": "string"
    },
    "prNumber": {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
    },
    "prUrl": {
      "type": "string"
    },
    "reason": {
      "type": "string"
    }
  },
  "required": [
    "prUrl",
    "prNumber",
    "integration",
    "posture",
    "mode",
    "externalLogins",
    "reason"
  ],
  "type": "object",
  "x-tanren-schema-id": "tanren.event.merge.blocked"
}
