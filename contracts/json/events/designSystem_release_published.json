{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "designSystemId": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    },
    "manifestDigest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "publishedBy": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    },
    "releaseId": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    },
    "signature": {
      "maxLength": 512,
      "minLength": 1,
      "type": "string"
    },
    "validationRunId": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    },
    "version": {
      "maximum": 9007199254740991,
      "minimum": 1,
      "type": "integer"
    }
  },
  "required": [
    "releaseId",
    "designSystemId",
    "version",
    "manifestDigest",
    "signature",
    "validationRunId",
    "publishedBy"
  ],
  "type": "object",
  "x-tanren-schema-id": "tanren.event.designSystem.release.published"
}
