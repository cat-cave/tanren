{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "bindingId": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    },
    "correlationId": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    },
    "evidenceDigest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "generation": {
      "maximum": 9007199254740991,
      "minimum": 1,
      "type": "integer"
    },
    "requirementId": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    },
    "validationId": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "validationId",
    "requirementId",
    "bindingId",
    "generation",
    "correlationId",
    "evidenceDigest"
  ],
  "type": "object",
  "x-tanren-schema-id": "tanren.event.integration.validation.passed"
}
