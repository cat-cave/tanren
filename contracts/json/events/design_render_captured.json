{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "a11yViolationCount": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "artifactDigest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "designContractVersion": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    },
    "renderId": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "scenarioKey": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "renderId",
    "artifactDigest",
    "scenarioKey",
    "designContractVersion",
    "a11yViolationCount"
  ],
  "type": "object",
  "x-tanren-schema-id": "tanren.event.design.render.captured"
}
