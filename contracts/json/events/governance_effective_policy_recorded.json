{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "bindingId": {
      "type": "string"
    },
    "effectivePolicyHash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "inputsDigest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "policyRevisionId": {
      "type": "string"
    },
    "projectId": {
      "type": "string"
    },
    "snapshotId": {
      "type": "string"
    },
    "subjectId": {
      "type": "string"
    },
    "subjectKind": {
      "enum": [
        "run",
        "change",
        "activation"
      ],
      "type": "string"
    },
    "tierId": {
      "type": "string"
    }
  },
  "required": [
    "projectId",
    "snapshotId",
    "bindingId",
    "tierId",
    "policyRevisionId",
    "effectivePolicyHash",
    "subjectKind",
    "subjectId",
    "inputsDigest"
  ],
  "type": "object",
  "x-tanren-schema-id": "tanren.event.governance.effective_policy.recorded"
}
