{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "catalogBuildDigest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "curationId": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    },
    "plainArtifactDigest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "tokenResolutionDigest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    }
  },
  "required": [
    "curationId",
    "plainArtifactDigest",
    "catalogBuildDigest",
    "tokenResolutionDigest"
  ],
  "type": "object",
  "x-tanren-schema-id": "tanren.event.designSystem.base.composed"
}
