{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "issueLoopId": {
      "type": "string"
    },
    "operation": {
      "type": "string"
    },
    "outboxId": {
      "type": "string"
    },
    "payloadHash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
