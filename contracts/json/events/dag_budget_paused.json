  "additionalProperties": false,
  "properties": {
    "ceilingUsd": {
      "minimum": 0,
      "type": "number"
    },
    "period": {
      "enum": [
        "monthly",
        "total"
      ],
      "type": "string"
    },
    "readyHeldBack": {
      "maximum": 9007199254740991,
