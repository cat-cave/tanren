{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "baseSha": {
      "pattern": "^[0-9a-f]{40}$",
      "type": "string"
    },
    "beamId": {
      "type": "string"
    },
    "frontierRunId": {
      "type": "string"
    },
    "frontierSpecId": {
      "type": "string"
    },
    "generation": {
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "type": "integer"
    },
    "integrationNodeId": {
      "type": "string"
    },
    "memberShas": {
      "items": {
        "pattern": "^[0-9a-f]{40}$",
        "type": "string"
      },
      "minItems": 1,
      "type": "array"
    },
    "planDigest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "projectId": {
      "type": "string"
    },
    "rank": {
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "type": "integer"
    }
  },
  "required": [
    "projectId",
    "beamId",
    "frontierRunId",
    "frontierSpecId",
    "planDigest",
    "integrationNodeId",
    "rank",
    "generation",
    "baseSha",
    "memberShas"
  ],
  "type": "object",
  "x-tanren-schema-id": "tanren.event.merge.beam.planned"
}
