{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "issueNumber": {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
    },
    "issueUrl": {
      "type": "string"
    },
    "label": {
      "type": "string"
    },
    "prUrl": {
      "type": "string"
    },
    "reason": {
      "enum": [
        "post_merge_failure"
      ],
      "type": "string"
    }
  },
  "required": [
    "reason",
    "issueNumber",
    "issueUrl",
    "prUrl",
    "label"
  ],
  "type": "object",
  "x-tanren-schema-id": "tanren.event.issue.opened"
}
