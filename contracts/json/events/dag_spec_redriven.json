{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "backoffSeconds": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "consecutiveSameFailure": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "failureCode": {
      "enum": [
        "workspace",
        "credential",
        "usage_limit",
        "merge",
        "deploy",
        "empty_writer_output",
        "speculative_assembly",
        "internal"
      ],
      "type": "string"
    },
    "runId": {
      "type": "string"
    },
    "source": {
      "enum": [
        "workflow_redrive",
        "prober_resume"
      ],
      "type": "string"
    },
    "specId": {
      "type": "string"
    },
    "stage": {
      "enum": [
        "bootstrap",
        "credentials",
        "workspace",
        "agent",
        "merge",
        "deploy",
        "run"
      ],
      "type": "string"
    },
    "workSignature": {
      "type": "string"
    }
  },
  "required": [
    "specId",
    "runId",
    "failureCode",
    "stage",
    "consecutiveSameFailure",
    "backoffSeconds"
  ],
  "type": "object",
  "x-tanren-schema-id": "tanren.event.dag.spec.redriven"
}
