{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "compiledHash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "policyId": {
      "minLength": 1,
      "type": "string"
    },
    "version": {
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "type": "integer"
    }
  },
  "required": [
    "policyId",
    "version",
    "compiledHash"
  ],
  "type": "object",
  "x-tanren-schema-id": "tanren.event.merge.policy.revised"
}
