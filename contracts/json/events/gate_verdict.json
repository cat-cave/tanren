{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "approvingActor": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "type": "string"
        },
        "kind": {
          "enum": [
            "human",
            "service"
          ],
          "type": "string"
        },
        "label": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "type": "object"
    },
    "durationMs": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "failedStep": {
      "type": "string"
    },
    "failedTier": {
      "type": "string"
    },
    "headSha": {
      "minLength": 1,
      "type": "string"
    },
    "initiatingActor": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "type": "string"
        },
        "kind": {
          "enum": [
            "human",
            "service"
          ],
          "type": "string"
        },
        "label": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "type": "object"
    },
    "passed": {
      "type": "boolean"
    },
    "policyVersion": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "steps": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "passed": {
            "type": "boolean"
          },
          "tier": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "tier",
          "passed"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "tiers": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "when": {
      "enum": [
        "per_iteration",
        "pre_audit",
        "pre_merge"
      ],
      "type": "string"
    }
  },
  "required": [
    "when",
    "headSha",
    "passed",
    "durationMs",
    "tiers",
    "steps"
  ],
  "type": "object",
  "x-tanren-schema-id": "tanren.event.gate.verdict"
}
