{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "runId": {
      "type": "string"
    },
    "specId": {
      "type": "string"
    },
    "threshold": {
      "enum": [
        "conservative",
        "moderate",
        "aggressive"
      ],
      "type": "string"
    },
    "unmergedAncestors": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "type": "array"
    }
  },
  "required": [
    "specId",
    "runId",
    "unmergedAncestors",
    "threshold"
  ],
  "type": "object",
  "x-tanren-schema-id": "tanren.event.dag.spec.speculative"
}
