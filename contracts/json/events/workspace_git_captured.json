{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "commits": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "message": {
            "type": "string"
          },
          "sha": {
            "type": "string"
          }
        },
        "required": [
          "sha",
          "message"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "diffBytes": {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
    },
    "workspacePath": {
      "type": "string"
    }
  },
  "required": [
    "workspacePath",
    "commits",
    "diffBytes"
  ],
  "type": "object",
  "x-tanren-schema-id": "tanren.event.workspace.git_captured"
}
