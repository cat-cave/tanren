{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "approvingActor": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "type": "string"
        },
        "kind": {
          "enum": [
            "human",
            "service"
          ],
          "type": "string"
        },
        "label": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "type": "object"
    },
    "initiatingActor": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "type": "string"
        },
        "kind": {
          "enum": [
            "human",
            "service"
          ],
          "type": "string"
        },
        "label": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "type": "object"
    },
    "integration": {
      "enum": [
        "native_queue",
        "direct_merge",
        "external_reviewer"
      ],
      "type": "string"
    },
    "mergeSha": {
      "type": "string"
    },
    "policyVersion": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "prNumber": {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
    },
    "prUrl": {
      "type": "string"
    }
  },
  "required": [
    "prUrl",
    "prNumber",
    "integration"
  ],
  "type": "object",
  "x-tanren-schema-id": "tanren.event.merge.completed"
}
