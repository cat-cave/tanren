{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "criteria_status": {
      "additionalProperties": false,
      "properties": {
        "criteria": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "criterion": {
                "type": "string"
              },
              "reason": {
                "type": "string"
              },
              "satisfied": {
                "type": "boolean"
              }
            },
            "required": [
              "criterion",
              "satisfied",
              "reason"
            ],
            "type": "object"
          },
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "criteria"
      ],
      "type": "object"
    },
    "outstandingBehaviorIds": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "passed": {
      "type": "boolean"
    },
    "reason": {
      "type": "string"
    },
    "reasoning": {
      "type": "string"
    },
    "recommendedAction": {
      "enum": [
        "pass",
        "loop_to_planner",
        "halt"
      ],
      "type": "string"
    },
    "verified": {
      "type": "boolean"
    }
  },
  "required": [
    "verified",
    "criteria_status",
    "reason"
  ],
  "type": "object",
  "x-tanren-schema-id": "tanren.event.auditor.completed"
}
