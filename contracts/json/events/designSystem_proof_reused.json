{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "proofReuseKey": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "releaseId": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    },
    "reusedProofId": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    },
    "validationRunId": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "validationRunId",
    "reusedProofId",
    "proofReuseKey",
    "releaseId"
  ],
  "type": "object",
  "x-tanren-schema-id": "tanren.event.designSystem.proof.reused"
}
