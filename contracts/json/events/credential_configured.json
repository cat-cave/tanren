{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "credentialKind": {
      "enum": [
        "codex_chatgpt_auth",
        "github_app",
        "github_token",
        "opaque"
      ],
      "type": "string"
    },
    "provider": {
      "type": "string"
    },
    "redacted": {
      "const": true,
      "type": "boolean"
    },
    "ref": {
      "type": "string"
    }
  },
  "required": [
    "provider",
    "credentialKind",
    "ref",
    "redacted"
  ],
  "type": "object",
  "x-tanren-schema-id": "tanren.event.credential.configured"
}
