{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "appId": {
      "type": "string"
    },
    "approvingActor": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "type": "string"
        },
        "kind": {
          "enum": [
            "human",
            "service"
          ],
          "type": "string"
        },
        "label": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "type": "object"
    },
    "artifact": {
      "additionalProperties": false,
      "properties": {
        "checksum": {
          "minLength": 1,
          "type": "string"
        },
        "provenanceRef": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "provenanceRef"
      ],
      "type": "object"
    },
    "deploymentId": {
      "type": "string"
    },
    "initiatingActor": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "type": "string"
        },
        "kind": {
          "enum": [
            "human",
            "service"
          ],
          "type": "string"
        },
        "label": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "type": "object"
    },
    "policyVersion": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "provider": {
      "type": "string"
    },
    "ref": {
      "type": "string"
    },
    "repo": {
      "type": "string"
    },
    "state": {
      "type": "string"
    },
    "url": {
      "type": "string"
    }
  },
  "required": [
    "provider",
    "appId",
    "repo",
    "ref",
    "deploymentId",
    "url",
    "state"
  ],
  "type": "object",
  "x-tanren-schema-id": "tanren.event.deploy.triggered"
}
