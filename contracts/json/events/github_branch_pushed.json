{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "branch": {
      "type": "string"
    },
    "credentialRef": {
      "type": "string"
    },
    "headSha": {
      "pattern": "^[0-9a-f]{40}$",
      "type": "string"
    },
    "redacted": {
      "const": true,
      "type": "boolean"
    },
    "repoUrl": {
      "type": "string"
    },
    "sourceRef": {
      "pattern": "^[0-9a-f]{40}$",
      "type": "string"
    }
  },
  "required": [
    "repoUrl",
    "branch",
    "headSha",
    "sourceRef",
    "credentialRef",
    "redacted"
  ],
  "type": "object",
  "x-tanren-schema-id": "tanren.event.github.branch.pushed"
}
