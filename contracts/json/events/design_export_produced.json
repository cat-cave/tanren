{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifactId": {
      "type": "string"
    },
    "exportId": {
      "type": "string"
    },
    "format": {
      "type": "string"
    },
    "outputDigest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "projectId": {
      "type": "string"
    }
  },
  "required": [
    "projectId",
    "artifactId",
    "exportId",
    "format",
    "outputDigest"
  ],
  "type": "object",
  "x-tanren-schema-id": "tanren.event.design.export.produced"
}
