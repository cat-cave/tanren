{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "correlationId": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    },
    "triggerDigest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "validationId": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "validationId",
    "correlationId",
    "triggerDigest"
  ],
  "type": "object",
  "x-tanren-schema-id": "tanren.event.integration.stimulus.emitted"
}
