{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifactDigest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "issueLoopId": {
      "type": "string"
    },
    "projectId": {
      "type": "string"
    },
    "releaseInstanceId": {
      "type": "string"
    },
    "resolutionJobId": {
      "type": "string"
    }
  },
  "required": [
    "projectId",
    "issueLoopId",
    "resolutionJobId",
    "releaseInstanceId",
    "artifactDigest"
  ],
  "type": "object",
  "x-tanren-schema-id": "tanren.event.deployment.artifact.bound"
}
