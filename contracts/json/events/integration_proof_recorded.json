{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "memberKey": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    },
    "nodeId": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    },
    "proofReuseKey": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    },
    "requiredBehaviorRevisionCount": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "runtimeBehaviorContextHash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "verdict": {
      "enum": [
        "passed",
        "failed",
        "unknown"
      ],
      "type": "string"
    }
  },
  "required": [
    "nodeId",
    "memberKey",
    "proofReuseKey",
    "verdict"
  ],
  "type": "object",
  "x-tanren-schema-id": "tanren.event.integration.proof.recorded"
}
