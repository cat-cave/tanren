{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifactDigest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "artifactId": {
      "type": "string"
    },
    "projectId": {
      "type": "string"
    },
    "releaseId": {
      "type": "string"
    }
  },
  "required": [
    "projectId",
    "artifactId",
    "releaseId",
    "artifactDigest"
  ],
  "type": "object",
  "x-tanren-schema-id": "tanren.event.design.artifact.published"
}
