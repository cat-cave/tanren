{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "policyHash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "projectId": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    },
    "revisionId": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    },
    "revisionNumber": {
      "maximum": 9007199254740991,
      "minimum": 1,
      "type": "integer"
    }
  },
  "required": [
    "revisionId",
    "projectId",
    "revisionNumber",
    "policyHash"
  ],
  "type": "object",
  "x-tanren-schema-id": "tanren.event.governance.policy.activated"
}
