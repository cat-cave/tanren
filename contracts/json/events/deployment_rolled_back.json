{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifactDigest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "deploymentId": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    },
    "reason": {
      "maxLength": 200,
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "deploymentId",
    "artifactDigest",
    "reason"
  ],
  "type": "object",
  "x-tanren-schema-id": "tanren.event.deployment.rolled_back"
}
