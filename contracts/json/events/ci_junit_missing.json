{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "headSha": {
      "type": "string"
    },
    "reason": {
      "enum": [
        "absent",
        "read_failed",
        "empty"
      ],
      "type": "string"
    },
    "reportPath": {
      "minLength": 1,
      "type": "string"
    },
    "tier": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "headSha",
    "tier",
    "reportPath",
    "reason"
  ],
  "type": "object",
  "x-tanren-schema-id": "tanren.event.ci.junit_missing"
}
