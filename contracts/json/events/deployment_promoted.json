{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifactDigest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "deploySha": {
      "pattern": "^[0-9a-fA-F]{40}$",
      "type": "string"
    },
    "deploymentId": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    },
    "environment": {
      "enum": [
        "preview",
        "staging",
        "production"
      ],
      "type": "string"
    }
  },
  "required": [
    "deploymentId",
    "artifactDigest",
    "deploySha",
    "environment"
  ],
  "type": "object",
  "x-tanren-schema-id": "tanren.event.deployment.promoted"
}
