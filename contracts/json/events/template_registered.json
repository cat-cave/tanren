{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "channel": {
      "enum": [
        "lts",
        "nightly"
      ],
      "type": "string"
    },
    "orgId": {
      "type": "string"
    },
    "repoRef": {
      "type": "string"
    },
    "stack": {
      "type": "string"
    },
    "status": {
      "enum": [
        "draft",
        "validated",
        "degraded",
        "official"
      ],
      "type": "string"
    },
    "templateId": {
      "type": "string"
    }
  },
  "required": [
    "templateId",
    "orgId",
    "repoRef",
    "stack",
    "channel",
    "status"
  ],
  "type": "object",
  "x-tanren-schema-id": "tanren.event.template.registered"
}
