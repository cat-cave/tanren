{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "attempt": {
      "maximum": 9007199254740991,
      "minimum": 1,
      "type": "integer"
    },
    "bodyPreview": {
      "maxLength": 500,
      "type": "string"
    },
    "canonicalSignature": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    },
    "decision": {
      "enum": [
        "continue",
        "converged",
        "halted_fixed_point"
      ],
      "type": "string"
    },
    "missionNodeId": {
      "const": "in-7",
      "type": "string"
    },
    "rejection": {
      "maxLength": 2000,
      "type": "string"
    },
    "unitId": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "missionNodeId",
    "unitId",
    "attempt",
    "bodyPreview",
    "canonicalSignature",
    "rejection",
    "decision"
  ],
  "type": "object",
  "x-tanren-schema-id": "tanren.event.integration.author.attempt"
}
