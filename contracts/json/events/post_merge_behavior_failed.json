{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "behaviorRevisionId": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    },
    "deploySha": {
      "pattern": "^[0-9a-fA-F]{40}$",
      "type": "string"
    },
    "outcome": {
      "enum": [
        "passed",
        "failed_product",
        "failed_verification_contract",
        "failed_visual",
        "inconclusive_infrastructure",
        "inconclusive_external",
        "cancelled_superseded"
      ],
      "type": "string"
    },
    "verdictId": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "behaviorRevisionId",
    "verdictId",
    "deploySha",
    "outcome"
  ],
  "type": "object",
  "x-tanren-schema-id": "tanren.event.post_merge.behavior.failed"
}
