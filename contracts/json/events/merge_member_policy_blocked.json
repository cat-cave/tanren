{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "classification": {
      "const": "deterministic_policy",
      "type": "string"
    },
    "disposition": {
      "const": "member_repair",
      "type": "string"
    },
    "evaluationId": {
      "pattern": "^mqeval_[0-9a-f]{64}$",
      "type": "string"
    },
    "findingIds": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array"
    },
    "groupId": {
      "pattern": "^mqgrp_[0-9a-f]{64}$",
      "type": "string"
    },
    "memberIds": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array"
    },
    "missionNodeId": {
      "const": "mq-1",
      "type": "string"
    },
    "reasonCode": {
      "const": "audit_policy",
      "type": "string"
    },
    "retryability": {
      "const": "non_retryable",
      "type": "string"
    },
    "signalVersion": {
      "const": "merge_signal.v1",
      "type": "string"
    },
    "wakeKey": {
      "type": "null"
    }
  },
  "required": [
    "missionNodeId",
    "evaluationId",
    "groupId",
    "signalVersion",
    "memberIds",
    "findingIds",
    "classification",
    "reasonCode",
    "retryability",
    "wakeKey",
    "disposition"
  ],
  "type": "object",
  "x-tanren-schema-id": "tanren.event.merge.member.policy_blocked"
}
