{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "bindings": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "bindingId": {
            "minLength": 1,
            "type": "string"
          },
          "connectionId": {
            "minLength": 1,
            "type": "string"
          },
          "createdAt": {
            "format": "date-time",
            "type": "string"
          },
          "currentGeneration": {
            "anyOf": [
              {
                "additionalProperties": false,
                "properties": {
                  "adapterVersion": {
                    "minLength": 1,
                    "type": "string"
                  },
                  "appEnvHash": {
                    "pattern": "^sha256:[0-9a-f]{64}$",
                    "type": "string"
                  },
                  "authGeneration": {
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991,
                    "type": "integer"
                  },
                  "generation": {
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991,
                    "type": "integer"
                  },
                  "grantGeneration": {
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991,
                    "type": "integer"
                  },
                  "grantId": {
                    "minLength": 1,
                    "type": "string"
                  },
                  "outputs": {
                    "items": {
                      "additionalProperties": false,
                      "properties": {
                        "classification": {
                          "enum": [
                            "secret",
                            "non_secret"
                          ],
                          "type": "string"
                        },
                        "logicalKey": {
                          "maxLength": 128,
                          "minLength": 1,
                          "type": "string"
                        },
                        "required": {
                          "type": "boolean"
                        },
                        "scopes": {
                          "items": {
                            "enum": [
                              "build",
                              "test",
                              "runtime",
                              "dev"
                            ],
                            "type": "string"
                          },
                          "minItems": 1,
                          "type": "array"
                        }
                      },
                      "required": [
                        "logicalKey",
                        "classification",
                        "required",
                        "scopes"
                      ],
                      "type": "object"
                    },
                    "minItems": 1,
                    "type": "array"
                  },
                  "ownership": {
                    "enum": [
                      "created",
                      "adopted",
                      "shared"
                    ],
                    "type": "string"
                  },
                  "resource": {
                    "additionalProperties": false,
                    "properties": {
                      "externalResourceId": {
                        "minLength": 1,
                        "type": "string"
                      },
                      "externalResourceName": {
                        "minLength": 1,
                        "type": "string"
                      }
                    },
                    "required": [
                      "externalResourceId",
                      "externalResourceName"
                    ],
                    "type": "object"
                  },
                  "teardownPolicy": {
                    "enum": [
                      "delete",
                      "retain"
                    ],
                    "type": "string"
                  }
                },
                "required": [
                  "generation",
                  "authGeneration",
                  "grantId",
                  "grantGeneration",
                  "adapterVersion",
                  "resource",
                  "ownership",
                  "teardownPolicy",
                  "appEnvHash",
                  "outputs"
                ],
                "type": "object"
              },
              {
                "type": "null"
              }
            ]
          },
          "currentGenerationNumber": {
            "anyOf": [
              {
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          },
          "driftState": {
            "enum": [
              "unknown",
              "in_sync",
              "drifted"
            ],
            "type": "string"
          },
          "environment": {
            "enum": [
              "test",
              "preview",
              "production"
            ],
            "type": "string"
          },
          "providerKind": {
            "minLength": 1,
            "type": "string"
          },
          "requirementId": {
            "minLength": 1,
            "type": "string"
          },
          "status": {
            "enum": [
              "pending",
              "ready",
              "drifted",
              "needs_attention",
              "retired"
            ],
            "type": "string"
          },
          "updatedAt": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "bindingId",
          "requirementId",
          "environment",
          "providerKind",
          "connectionId",
          "currentGenerationNumber",
          "status",
          "driftState",
          "createdAt",
          "updatedAt",
          "currentGeneration"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "orgId": {
      "minLength": 1,
      "type": "string"
    },
    "projectId": {
      "minLength": 1,
      "type": "string"
    },
    "version": {
      "const": "v1",
      "type": "string"
    }
  },
  "required": [
    "version",
    "orgId",
    "projectId",
    "bindings"
  ],
  "type": "object",
  "x-tanren-schema-id": "tanren.integrations.read.v1.IntegrationBindingsResponse"
}
