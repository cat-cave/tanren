    "orgId": {
      "minLength": 1,
      "type": "string"
    },
    "projectId": {
      "minLength": 1,
      "type": "string"
    },
    "version": {
      "const": "v1",
      "type": "string"
    }
  },
  "required": [
    "version",
    "orgId",
    "projectId",
    "deliveryRuns"
  ],
  "type": "object",
  "x-tanren-schema-id": "tanren.integrations.read.v1.DeliveryDagStatusResponse"
}
