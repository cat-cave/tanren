{
  "name": "tanren",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.1.0",
  "scripts": {
    "build": "turbo run build",
    "check": "just ci",
    "check:answerer-schema-drift": "node scripts/answerer-schema-export.mjs --check",
    "check:contract-schema-drift": "node scripts/contract-schema-export.mjs --check",
    "check:dashboard-types-drift": "node scripts/gen-dashboard-types.mjs --check",
    "check:architecture": "node scripts/check-architecture.mjs",
    "check:fast": "just fast-check",
    "check:schema-drift": "bash scripts/check-schema-drift.sh",
    "check:state-drift": "node scripts/generate-state-checks.mjs --check",
    "check:event-drift": "node scripts/generate-event-type-check.mjs --check",
    "check:knip": "knip",
    "check:mutation": "stryker run",
    "check:spelling": "cspell --no-progress \"**/*.{ts,tsx,js,mjs,md,yml,yaml}\"",
    "check:types-lint": "eslint .",
    "codegen:answerer-schemas": "node scripts/answerer-schema-export.mjs",
    "codegen:contract-schemas": "node scripts/contract-schema-export.mjs",
    "codegen:dashboard-types": "node scripts/gen-dashboard-types.mjs",
    "codegen:state": "node scripts/generate-state-checks.mjs",
    "codegen:events": "node scripts/generate-event-type-check.mjs",
    "compose:config": "docker compose -f compose.dev.yml config --quiet",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "format:check": "node scripts/format-check.mjs",
    "lint": "oxlint -c oxlintrc.json .",
    "test": "vitest run --coverage",
    "test:no-coverage": "vitest run",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.1",
    "@commitlint/config-conventional": "^21.0.1",
    "@stryker-mutator/core": "9.6.1",
    "@stryker-mutator/vitest-runner": "9.6.1",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.11.11",
    "@types/ssh2": "1.15.5",
    "@vitest/coverage-v8": "3.2.4",
    "cspell": "^10.0.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.4.0",
    "knip": "^6.14.0",
    "lefthook": "2.1.8",
    "oxlint": "^1.0.0",
    "prettier": "^3.8.3",
    "tsx": "^4.19.2",
    "turbo": "^2.5.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.60.0",
    "vitest": "^3.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "cpu-features",
      "esbuild",
      "ssh2"
    ]
  }
}
