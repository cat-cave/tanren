{
  "name": "tanren",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.1.0",
  "scripts": {
    "build": "pnpm -r build",
    "check": "pnpm run format:check && pnpm run lint && pnpm run check:architecture && pnpm run typecheck && pnpm run test && pnpm run build && pnpm run compose:config",
    "check:architecture": "node scripts/check-architecture.mjs",
    "compose:config": "docker compose config --quiet",
    "format:check": "node scripts/format-check.mjs",
    "lint": "oxlint -c oxlintrc.json .",
    "test": "vitest run",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.11.11",
    "oxlint": "^1.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.8.0",
    "vitest": "^3.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
