{
  "name": "tanren",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.1.0",
  "scripts": {
    "build": "pnpm -r build",
    "check": "just ci",
    "check:architecture": "node scripts/check-architecture.mjs",
    "check:fast": "just fast-check",
    "check:schema-drift": "bash scripts/check-schema-drift.sh",
    "check:state-drift": "node scripts/generate-state-checks.mjs --check",
    "codegen:state": "node scripts/generate-state-checks.mjs",
    "compose:config": "docker compose -f compose.dev.yml config --quiet",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "format:check": "node scripts/format-check.mjs",
    "lint": "oxlint -c oxlintrc.json .",
    "test": "vitest run",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "@mergifyio/vitest": "0.2.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.11.11",
    "@types/ssh2": "1.15.5",
    "drizzle-kit": "^0.31.10",
    "lefthook": "2.1.8",
    "oxlint": "^1.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.8.0",
    "vitest": "^3.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "cpu-features",
      "esbuild",
      "ssh2"
    ]
  }
}
