{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "vitest", "import"],
  "ignorePatterns": ["dist/**", "node_modules/**", "coverage/**", "tanren-hi-fidelity/**"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "pedantic": "warn",
    "perf": "warn"
  },
  "rules": {
    "eqeqeq": "error",
    "no-debugger": "error",
    "no-await-in-loop": "off",
    "no-var": "error",
    "prefer-const": "error",
    "no-console": "off",
    "no-loop-func": "error",
    "no-useless-return": "error",
    "no-warning-comments": "error",
    "no-promise-executor-return": "error",
    "no-inline-comments": "error",
    "no-negated-condition": "error",
    "require-unicode-regexp": "error",
    // require-await (wave 6): enforced as error everywhere a plain async function
    // with a sync body is just a mistake. Scoped OFF for the adapter/port seam
    // layers (see overrides) where async-with-sync-body is the intentional
    // conformance pattern: a contract types its method `(): Promise<T>` so a sync
    // in-memory impl and a real I/O impl are interchangeable behind one interface.
    // Removing `async` there would change the awaited return type / break the
    // contract. The genuinely-pointless standalone cases were fixed in code.
    "require-await": "error",
    // no-conditional-in-test (wave 6): OFF, by design — not a hidden-branch problem
    // in this codebase. Every flagged `if`/ternary is one of two intentional
    // patterns: (1) fetch-mock routers that dispatch a faked request to its canned
    // response (`if (url.includes(...)) return ...`) — the backbone of every
    // adapter-conformance test (OIDC/GitHub IdPs, allocators, secret stores), and
    // (2) value normalizers / disjunction assertions (`x ?? null`,
    // `expect(a === "" || a === null).toBe(true)`). None are a branch that should
    // become two test cases, so the rule produces only un-actionable noise here.
    "vitest/no-conditional-in-test": "off",
    // Structural max-* rules (wave 5). Thresholds are tuned to this codebase
    // (Hono route-builders, JSX render trees, in-memory test fakes) so they
    // catch genuine god-functions/files, not stylistic length. See PR wave 5.
    //
    // max-lines: aligned to the 500-line file cap that scripts/check-architecture.mjs
    // already enforces — one source of truth for file size, no duplicate ceiling.
    "max-lines": ["error", { "max": 500, "skipBlankLines": false, "skipComments": false }],
    // max-lines-per-function: 220. The longest functions here are declarative
    // route-registration aggregators and JSX render trees whose length is already
    // bounded by the 500-line file cap; 220 flags only true god-aggregators.
    // Comments are skipped so doc-heavy handlers are measured by code, not prose.
    "max-lines-per-function": ["error", { "max": 220, "skipComments": true }],
    // max-classes-per-file: 5. Default 1 is too strict — a domain-errors module
    // legitimately groups a cluster of small Error subclasses, and a test file
    // groups a few small stub/fake classes. 5 matches that natural ceiling while
    // still flagging files that mix many substantial classes.
    "max-classes-per-file": ["error", { "max": 5 }],
    // max-dependencies: 12 runtime (value) imports; type-only imports are ignored
    // because they create no runtime coupling. Catches genuinely-egregious import
    // lists (e.g. composition roots) without penalizing type-rich modules.
    "import/max-dependencies": ["error", { "max": 12, "ignoreTypeImports": true }],
    "unicorn/no-array-sort": "off",
    "unicorn/prefer-node-protocol": "error",
    "unicorn/no-useless-undefined": "error",
    "unicorn/prefer-at": "error",
    "unicorn/prefer-dom-node-append": "error",
    "unicorn/prefer-string-replace-all": "error",
    "unicorn/prefer-type-error": "error",
    "unicorn/prefer-import-meta-properties": "error",
    "unicorn/no-array-callback-reference": "error",
    "unicorn/no-immediate-mutation": "error",
    "unicorn/no-object-as-default-parameter": "error",
    "unicorn/prefer-regexp-test": "error",
    "unicorn/no-lonely-if": "error",
    "unicorn/prefer-math-min-max": "error",
    "unicorn/prefer-dom-node-dataset": "error",
    "unicorn/prefer-code-point": "error",
    "unicorn/no-unnecessary-array-splice-count": "error",
    // prefer-event-target: ratcheted warn→error now that the remaining hits are
    // all under tests/**, which is exempted in the test-glob override below.
    // Production source carries ZERO EventEmitter use today; this gate keeps it
    // that way. Test files legitimately `new EventEmitter()` to mock ssh2's
    // Client (and pg's PoolClient) — both Node-only EventEmitters; the SUT
    // subscribes via `.on(...)`, so rewriting mocks to EventTarget would mean
    // wrapping ssh2/pg in a translator (much bigger than a style lint warrants).
    // The test-glob override below is the seam.
    "unicorn/prefer-event-target": "error",
    // Mechanical-cleanup ratchets from the same warn→error wave (ROADMAP §3
    // doctrine: oxlint warnings driven down + every cleaned rule pinned at error
    // so it can't regress).
    "unicorn/explicit-length-check": "error",
    "unicorn/prefer-math-trunc": "error",
    "unicorn/prefer-set-has": "error",
    "unicorn/prefer-top-level-await": "error",
    "unicorn/no-useless-promise-resolve-reject": "error",
    "typescript/consistent-type-imports": "error",
    "vitest/no-disabled-tests": "error",
    "vitest/no-focused-tests": "error",
    "import/no-cycle": "error",
    "import/no-self-import": "error"
  },
  "overrides": [
    {
      // Test files + their helpers/fixtures are dominated by a single top-level
      // describe() callback and by in-memory fake builders that return one large
      // object literal. Per-function length there is redundant with the 500-line
      // file cap (already enforced for tests too), so this rule only on test
      // sources would produce "split your describe" noise with no behavior value.
      "files": ["**/*.test.ts", "**/*.test.tsx", "**/*.spec.ts", "**/tests/**", "**/*.fixtures.ts"],
      "rules": {
        "max-lines-per-function": "off",
        // unicorn/prefer-event-target OFF for tests (lane C). The orchestrator
        // tests mock ssh2's `Client` and pg's `PoolClient` — both of which are
        // Node-only EventEmitters — by `new EventEmitter()` + `.emit("ready"|
        // "error"|"close"|"notification", ...)`. The SUT (production code)
        // subscribes via `.on(...)`, so the test fakes MUST match that API.
        // Rewriting the mocks to EventTarget would require wrapping ssh2/pg in
        // a translator on the production side, which is a much larger change
        // than this style lint warrants. Production-source EventEmitter use is
        // still gated `error` (above), so this exemption is scoped to test
        // doubles of Node-only library surfaces.
        "unicorn/prefer-event-target": "off"
      }
    },
    {
      // Composition roots + route mount tables aggregate the whole service by
      // design — main.ts assembles the app, and mountFeatureRoutes is the
      // declarative create*Routes mount table. A leaf-module import ceiling does
      // not apply to them; they are held to a higher bound (still capped so the
      // list cannot grow without bound). max-dependencies counts runtime imports
      // only — type-only imports are already ignored at the base config.
      "files": ["services/orchestrator/src/main.ts", "services/orchestrator/src/mountFeatureRoutes.ts"],
      "rules": {
        "import/max-dependencies": ["error", { "max": 24, "ignoreTypeImports": true }]
      }
    },
    {
      // require-await OFF for the adapter/port seam layers (wave 6). These are the
      // slottable-contract surfaces — providers, allocators, notification
      // channels, the forge inbox/interview/discovery answerers, secret stores,
      // identity providers, observability wrappers, the contracts/ port
      // definitions, the Hono route handlers, and the dashboard RPC clients. They
      // type their methods/callbacks `(): Promise<T>` so a synchronous in-memory
      // impl (fakes, no-op policies, static stores) and a real-I/O impl satisfy
      // ONE interface and are interchangeable behind it. Marking such a method
      // `async` with a sync body is required conformance, not a mistake — removing
      // `async` would change the awaited return type or break the contract the
      // conformance suites (tests/conformance/**) pin. The rule stays `error`
      // everywhere outside these directories.
      "files": [
        "**/engine/**",
        "**/src/auth/**",
        "**/src/routes/**",
        "services/dashboard/src/api/**",
        "services/allocator/src/**"
      ],
      "rules": {
        "require-await": "off"
      }
    },
    {
      // require-await OFF for tests/helpers/fixtures (wave 6). Test suites are
      // dominated by in-memory fakes and stubs that implement the same
      // Promise-typed ports as production (fake allocators/providers/secret
      // stores/notification channels, fetch-mock routers, fixture builders). Their
      // bodies are synchronous but the method signatures must stay async to
      // satisfy the interface under test, so the same conformance rationale as the
      // seam-layer override applies here.
      "files": ["**/*.test.ts", "**/*.test.tsx", "**/*.spec.ts", "**/tests/**", "**/*.fixtures.ts"],
      "rules": {
        "require-await": "off"
      }
    }
  ]
}
