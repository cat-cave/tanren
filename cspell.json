{
  "$schema": "https://raw.githubusercontent.com/streetsidesoftware/cspell/main/cspell.schema.json",
  "version": "0.2",
  "language": "en",
  "caseSensitive": false,
  "files": ["**/*.{ts,tsx,js,mjs,md,yml,yaml}"],
  "enableFiletypes": ["mjs"],
  "ignorePaths": [
    "node_modules/**",
    "**/dist/**",
    "coverage/**",
    ".pnpm-store/**",
    ".turbo/**",
    "pnpm-lock.yaml",
    "**/*.local.yaml",
    "**/*.local.yml",
    "**/.env*",
    "db/migrations/**",
    "services/orchestrator/src/engine/answerers/schemas/generated/**",
    "contracts/json/**",
    "services/orchestrator/src/engine/costs/pricing/model_prices.json",
    "tanren-hi-fidelity/**",
    ".claude/**",
    "PROJECT_BRIEF.md",
    "ROADMAP.md",
    "skills-lock.json",
    ".env.example"
  ],
  "ignoreRegExpList": ["/\\b[0-9a-f]{7,40}\\b/", "/[A-Za-z0-9+/]{24,}={0,2}/"],
  "dictionaries": ["tanren"],
  "overrides": [
    {
      "filename": [
        "services/dashboard/src/components/audits/**",
        "services/dashboard/src/components/inbox/**",
        "services/dashboard/src/components/onboarding/**",
        "services/dashboard/src/components/project/DagEdges.tsx"
      ],
      "comment": "CSS class-name fragments (afind/wbody/nlabel/rname/...) are local selector prefixes, not prose.",
      "words": [
        "afind",
        "alast",
        "anames",
        "asched",
        "acli",
        "wbody",
        "wlabel",
        "wtext",
        "nbody",
        "nlabel",
        "rname",
        "rdesc",
        "bparr"
      ]
    },
    {
      "filename": ["services/orchestrator/tests/**", "services/dashboard/tests/**"],
      "comment": "Synthetic fake-data identifiers used only as test fixtures.",
      "words": [
        "akia",
        "akiaexample",
        "aemail",
        "afatal",
        "aorg",
        "atanren",
        "aunresolved",
        "auser",
        "fapp",
        "fauth",
        "fcallback",
        "fhard",
        "flifecycle",
        "fopaque",
        "fplanner",
        "fprojects",
        "fprovider",
        "frun",
        "fscaffold",
        "ftanren",
        "funexpected",
        "fworker",
        "fworkflows",
        "forg",
        "sess",
        "sntrys",
        "appsha",
        "utingkey",
        "bcccc",
        "jjapplier",
        "noexist",
        "statik",
        "aproj"
      ]
    }
  ],
  "dictionaryDefinitions": [
    {
      "name": "tanren",
      "path": "./cspell-words.txt"
    }
  ],
  "dictionaryDefinitions": [
    {
      "name": "tanren",
      "path": "./cspell-words.txt"
    }
  ],
  "dictionaryDefinitions": [{ "name": "tanren", "path": "./cspell-words.txt" }]
}
