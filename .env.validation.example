# =============================================================================
# Tanren — validation ENV layer (.env.validation.example)
# =============================================================================
# THIS FILE IS DELIBERATELY SMALL.
#
# Env vars are the EXCEPTION, not the rule. Only two classes of thing belong
# here:
#   (1) Process-bootstrap that must exist BEFORE the secret manager does
#       (you cannot store the secret-manager's own address/token inside the
#        secret manager — chicken/egg), and
#   (2) Test injection — flags + pointers the `just live-*` / `just e2e`
#       harness reads to find raw material and to bootstrap a fresh stack.
#
# EVERYTHING ELSE — GitHub App, provider auth, cloud allocators, identity
# providers, notification channels, intake sources, deploy targets — is a
# MANAGED CREDENTIAL. It lives in user configuration → the secret manager,
# declared in `connections.manifest.yaml` (see connections.manifest.example.yaml)
# and configured in production through the dashboard / `tanren credentials create`.
# Do NOT add those here for production; they only appear under §3 below as
# TEST bootstrap sources.
# =============================================================================


# -----------------------------------------------------------------------------
# §1  INFRA BOOTSTRAP (genuine env — exists before the secret manager)
# -----------------------------------------------------------------------------
# The database the orchestrator/worker connect to.
DATABASE_URL=postgres://tanren:tanren@localhost:5432/tanren

# Which secret-store backend the WHOLE app uses. No default — unset throws.
#   vault | gcp_sm | aws_sm | onepassword | memory   (memory = tests/dev only)
TANREN_SECRET_STORE=vault

# --- the selected backend's OWN connection (this is the irreducible bootstrap
#     credential: the key that unlocks every other managed credential) ---
# vault:
VAULT_ADDR=http://127.0.0.1:8200
VAULT_TOKEN=
# VAULT_KV_MOUNT=secret           # optional
# gcp_sm:    TANREN_GCP_SM_PROJECT= , TANREN_GCP_SM_ACCESS_TOKEN= [, _API_BASE]
# aws_sm:    TANREN_AWS_SM_ACCESS_KEY_ID= , _SECRET_ACCESS_KEY= , _REGION= [, _SESSION_TOKEN, _NAME_PREFIX, _ENDPOINT]
# onepassword: TANREN_OP_CONNECT_URL= , TANREN_OP_CONNECT_TOKEN= , TANREN_OP_VAULT_ID= [, _FIELD_LABEL]

# Service URLs/ports (local stack).
ORCHESTRATOR_URL=http://127.0.0.1:3100
# DASHBOARD_PORT=3000


# -----------------------------------------------------------------------------
# §2  LOCAL RUNNER SUBSTRATE (test infra — the compose runner over SSH)
# -----------------------------------------------------------------------------
# Real-world runs provision runners via a (managed-config) allocator. These vars
# only exist to point the LOCAL integration/live tests at the compose runner.
TANREN_SSH_HOST=127.0.0.1
TANREN_SSH_PORT=2222
TANREN_SSH_USER=tanren
# TANREN_SSH_KEY_PATH=/tmp/tanren_runner_key
# TANREN_SSH_HOST_FINGERPRINT=          # from ssh-keyscan; the recipes derive it
# TANREN_SSH_HOST_KEY_ALGORITHMS=ssh-ed25519


# -----------------------------------------------------------------------------
# §3  TEST GATING FLAGS + RAW-MATERIAL POINTERS (test-only injection)
# -----------------------------------------------------------------------------
# These switch on the opt-in live/e2e suites and tell the harness WHERE to read
# the raw secret material it will IMPORT into the fresh test stack's secret
# manager (per connections.manifest.yaml). In production this material is set
# through the product UI and never touches env.
#
# Gating switches (off by default; the per-PR fast path never sets these):
# TANREN_SSH_INTEGRATION=1
# TANREN_CODEX_LIVE=1
# TANREN_CODEX_ANSWERER_LIVE=1
# TANREN_GITHUB_LIVE=1
# TANREN_PHASE1_FIXTURE_LIVE=1
# TANREN_E2E=1                          # the new `just e2e` master switch (P8b)

# File pointers to raw bootstrap material (paths, never inline secrets):
# TANREN_CODEX_AUTH_JSON_FILE=/abs/path/to/codex/auth.json
# TANREN_GITHUB_TOKEN_FILE=/abs/path/to/github-token.txt
# TANREN_GITHUB_REPO_URL=https://github.com/<owner>/<fixture-repo>
# TANREN_GITHUB_BASE_BRANCH=main

# The e2e harness reads ONE manifest and imports everything in it into the fresh
# stack before the suite runs. This is the single seam that keeps real-setup and
# testing using the same declarations:
# TANREN_CONNECTIONS_MANIFEST=/abs/path/to/connections.manifest.yaml

# The enforced budget ceiling for any real-credit run (apex). Codex is
# subscription-covered; this caps everything else.
# TANREN_BUDGET_CEILING_USD=50
