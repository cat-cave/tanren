{
  "name": "@tanren/orchestrator",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json && node ../../scripts/copy-orchestrator-runtime-assets.mjs",
    "dev": "tsx src/main.ts",
