{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "findings": {
      "description": "Completeness findings (ALL treated as P0): one entry per way this task is not yet complete for what downstream tasks depend on. Empty array = complete.",
      "items": {
        "additionalProperties": false,
        "properties": {
          "behaviorId": {
            "anyOf": [
              {
                "maxLength": 120,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "body": {
            "description": "What downstream-relevant part of the task is missing/incomplete, with enough context to act on.",
            "maxLength": 6000,
            "minLength": 1,
            "type": "string"
          },
          "id": {
            "maxLength": 120,
            "minLength": 1,
            "type": "string"
          },
          "title": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "id",
          "title",
          "body",
          "behaviorId"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "reasoning": {
      "description": "Per-criterion rationale: cite each acceptance criterion / behavior the downstream depends on and state whether the change delivers it. Do not assert or speculate about test/build/lint results (the gate owns those).",
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "findings",
    "reasoning"
  ],
  "type": "object",
  "x-tanren-schema-id": "tanren.check_answer.v3"
}
