DATABASE_URL=postgres://tanren:tanren@postgres:5432/tanren
VAULT_ADDR=http://vault:8200
VAULT_HOST_ADDR=http://localhost:18200
VAULT_TOKEN=dev-root-token
ORCHESTRATOR_PORT=3100
DASHBOARD_PORT=3000
TANREN_ORCHESTRATOR_URL=http://localhost:3100
# Host port the dashboard is published on (in-container port stays 3000).
# Uncomment + change if host :3000 is already taken. Defaults to 3000.
# DASHBOARD_HOST_PORT=3000

# DEV-ONLY sign-in escape hatch. Copy this file to `.env` (gitignored), then
# `just up-dev`. Compose auto-reads `.env` in the repo root for the ${VAR:-}
# defaults in compose.dev.yml. Both default OFF when unset, so CI's open smoke
# flow is unaffected. compose.prod.yml never reads them.
#
# TANREN_DEV_LOGIN registers the orchestrator's local_dev identity provider and
# surfaces a one-click "sign in (dev)" button in the dashboard, so you land
# authenticated without registering a GitHub OAuth app.
# TANREN_REQUIRE_AUTH gates the dashboard so the sign-in flow is actually driven.
# See docs/operator-guide/auth.md.
TANREN_DEV_LOGIN=1
TANREN_REQUIRE_AUTH=1

# Run-executor worker (P3-0001): when set, the orchestrator dequeues queued runs
# and drives them end-to-end (plan→write→gate→check→audit→PR→CI→review→merge).
# Required for real-loop manual validation; OFF by default so CI smoke/tests are
# unaffected. TANREN_RUN_WORKER_CONCURRENCY bounds in-flight runs (default 2).
TANREN_RUN_WORKER=1
# TANREN_RUN_WORKER_CONCURRENCY=2

# OIDC identity provider (additive, opt-in). The orchestrator registers the
# `oidc` provider only when issuer + client id + client secret are all set;
# leaving them unset keeps GitHub OAuth / dev-login behavior unchanged.
#
# TANREN_OIDC_PRESET=authentik is the turnkey homelab path: it fills Authentik's
# standard claim mapping (preferred_username -> login, name -> display name,
# groups -> orgs) and the `openid profile email groups` scopes by default, so you
# only supply issuer + client id/secret. Explicit TANREN_OIDC_*_CLAIM / _SCOPES
# envs still override the preset. See docs/operator-guide/oidc-authentik.md.
# TANREN_OIDC_PRESET=authentik
# TANREN_OIDC_ISSUER=https://authentik.home.lan/application/o/tanren/
# TANREN_OIDC_CLIENT_ID=
# TANREN_OIDC_CLIENT_SECRET=
