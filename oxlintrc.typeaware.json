{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript"],
  // The TYPE-AWARE lint pass (oxlint --type-aware, powered by oxlint-tsgolint/tsgo).
  // It replaced the old ESLint + typescript-eslint pass — same idea, no tsc.
  //
  // STRICTNESS RATCHET (WS-H1, rule-by-rule). The `correctness` category — the
  // highest-value typed bug-catchers — is now ON at error. Its rules
  // (`no-base-to-string`, `restrict-template-expressions`,
  // `no-redundant-type-constituents`) were triaged to zero and the surfaced code
  // FIXED (a `[object Object]`-stringification class on raw pg rows + Hono form
  // bodies, a couple of `never`-template guards, two redundant union members) —
  // not silenced. The one correctness rule held OFF is `unbound-method`: every
  // one of its 32 hits is a FALSE POSITIVE on a function-VALUED object property
  // (the credential `refresh: () => Promise<string>` and the poll `sleep`
  // fields), which carries no `this` binding — the rule's heuristic can't tell
  // those from a real class method. It is NOT disabled to dodge work; the rest
  // of the category is at error.
  //
  // The remaining categories stay OFF pending follow-up rule-by-rule ratchets
  // (suspicious/pedantic/style/restriction/nursery — see the WS-H1 PR body for
  // per-rule finding counts). The 3 original high-value typed rules below stay
  // pinned (they predate the category being on; keeping them explicit documents
  // the floor).
  "categories": {
    "correctness": "error",
    "suspicious": "off",
    "pedantic": "off",
    "perf": "off",
    "style": "off",
    "restriction": "off",
    "nursery": "off"
  },
  "rules": {
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error",
    "typescript/await-thenable": "error",
    // FALSE-POSITIVE-only on this codebase (function-valued `refresh`/`sleep`
    // object properties, not class methods). Held off with rationale, not to
    // dodge work — the rest of `correctness` is at error above.
    "typescript/unbound-method": "off"
  }
}
