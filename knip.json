{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["scripts/**/*.{mjs,ts}"],
      "project": ["scripts/**/*.{mjs,ts}"]
    },
    "cli": {
      "entry": ["tests/**/*.test.ts"],
      "project": ["src/**/*.ts"]
    },
    "db": {
      "project": ["src/**/*.ts"]
    },
    "ops/cra": {
      "entry": ["src/index.ts", "src/main.ts", "tests/**/*.test.ts"],
      "project": ["src/**/*.ts"]
    },
    "services/orchestrator": {
      "entry": ["tests/**/*.test.ts"],
      "project": ["src/**/*.ts"]
    },
    "services/allocator": {
      "entry": ["src/index.ts", "tests/**/*.test.ts"],
      "project": ["src/**/*.ts"]
    },
    "services/dashboard": {
      "entry": ["src/client/index.ts", "tests/**/*.test.ts"],
      "project": ["src/**/*.{ts,tsx}"]
    }
  },
  "ignore": [
    "services/dashboard/src/design/index.ts",
    "services/dashboard/src/design/tokens.ts",
    "services/dashboard/src/api/http.gen.ts",
    "services/orchestrator/src/engine/contracts/cas.ts",
    "services/orchestrator/src/engine/contracts/behaviorRevision.ts",
    "services/orchestrator/src/engine/contracts/authoringKernel.ts",
    "services/orchestrator/src/engine/contracts/fixtureLeaseAdapter.ts",
    "services/orchestrator/src/engine/contracts/sideEffectObserverAdapter.ts",
    "services/orchestrator/src/engine/contracts/resolutionStage.ts",
    "services/orchestrator/src/engine/contracts/mergeAuthority.ts",
    "services/orchestrator/src/engine/contracts/runtimeVerification.ts",
    "services/orchestrator/src/engine/contracts/runtimeVerificationPlan.ts",
    "services/orchestrator/src/engine/contracts/runtimeVerificationAdapters.ts",
    "services/orchestrator/src/engine/contracts/deployAdapter.ts",
    "services/orchestrator/src/engine/contracts/gateProof.ts",
    "services/orchestrator/src/engine/notifications/eventVocabulary.ts",
    "services/orchestrator/src/engine/design/system/index.ts",
    "services/orchestrator/src/engine/design/render/index.ts",
    "services/orchestrator/src/engine/design/system/designContractV2.ts",
    "services/orchestrator/src/engine/design/system/designTargetAdapter.ts",
    "db/src/eventTypesSeed.ts"
  ],
  "ignoreDependencies": ["@playwright/test", "hono", "@commitlint/cli", "@radix-ui/react-slot"],
  "ignoreBinaries": ["just", "playwright"],
  "ignoreExportsUsedInFile": true,
  "rules": {
    "nsExports": "off",
    "nsTypes": "off",
    "enumMembers": "off"
  }
}
